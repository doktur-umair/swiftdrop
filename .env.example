# Local development only. Copy to .env; generate ignored keys before starting.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
API_ISSUER=http://localhost:3000
HUMAN_AUDIENCE=swiftdrop-web
DATABASE_URL=postgresql://swiftdrop:local-development-only@localhost:5432/swiftdrop
REDIS_URL=redis://localhost:6380
RABBITMQ_URL=amqp://guest:guest@localhost:5672
AUTH_PRIVATE_KEY_FILE=.local/auth/private.pem
AUTH_PUBLIC_KEYS_FILE=.local/auth/public-keys.json
AUTH_KEY_ID=local-1
CSRF_SECRET_FILE=.local/auth/csrf.key
RATE_LIMIT_SECRET_FILE=.local/auth/rate-limit.key
OAUTH_TRANSACTION_SECRET_FILE=.local/auth/oauth.key
COOKIE_SECURE=false
CUSTOMER_IDLE_SECONDS=604800
CUSTOMER_ABSOLUTE_SECONDS=2592000
STAFF_IDLE_SECONDS=43200
STAFF_ABSOLUTE_SECONDS=86400
# Local-only Mailpit SMTP. Production must use its private secret store and approved relay.
SMTP_URL=smtp://localhost:1025
# Reserved for later phases.
# MERCHANT_AUDIENCE=swiftdrop-merchant
# SERVICE_ISSUER=
# SERVICE_AUDIENCE=swiftdrop-workers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
# When enabled, set callback URL to http://localhost:5173/api/v1/auth/google/callback
# MFA_ENCRYPTION_KEY_FILE=
# MAIL_ENCRYPTION_KEY_FILE=
